    "authors": [
        {
            "name": "Gavin Taylor",
            "homepage": "https://github.com/gavtaylor"
        }
    ],
    "support": {
        "issues": "https://github.com/gavtaylor/roundcube-rememberme/issues",
        "source": "https://github.com/gavtaylor/roundcube-rememberme"
    },
    "require": {
        "php": ">=8.1.0",
        "ext-openssl": "*",
        "roundcube/plugin-installer": "~0.3.5"
